# 09:00 Asia/Taipei; 11:00 resumes a day that failed or was killed (a succeeded day exits at once).
# A Persistent catch-up before 09:00 exits as not_due (EARLIEST_HOUR in web/src/services/run-daily.ts).
[Unit]
Description=side-income daily run at 09:00 Asia/Taipei, resumed at 11:00

[Timer]
OnCalendar=*-*-* 09:00:00 Asia/Taipei
OnCalendar=*-*-* 11:00:00 Asia/Taipei
Persistent=true

[Install]
WantedBy=timers.target
