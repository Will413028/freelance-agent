# The daily run (plan step 6). Install on the VM (root, with Will's authorization):
#   install -m 0644 deploy/systemd/side-income-daily.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now side-income-daily.timer
[Unit]
Description=side-income daily run
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/side-income
# The browser tier (plan step 8d) for the run; "-": if it cannot start (e.g. its image is missing) the run
# still goes ahead and only the browser-tier sources fail. Removed after the run whatever its outcome,
# so Chromium holds no memory between runs.
ExecStartPre=-/usr/bin/docker compose --env-file /etc/side-income/compose.env -f deploy/compose.yaml --profile jobs up -d --wait browser
# A fixed container name, so the stop below reaches the run container itself and not only the compose client;
# a leftover one (e.g. after a docker restart mid-run) is removed first, or the name would block every start.
ExecStartPre=-/usr/bin/docker rm --force side-income-daily
ExecStart=/usr/bin/docker compose --env-file /etc/side-income/compose.env -f deploy/compose.yaml run --rm --name side-income-daily daily
ExecStopPost=/usr/bin/docker compose --env-file /etc/side-income/compose.env -f deploy/compose.yaml --profile jobs rm --stop --force browser
# A run that timed out or was stopped: its container goes too (design review 12e O4), so the 11:00 start never
# overlaps it. "-": after a normal run --rm has already removed it.
ExecStopPost=-/usr/bin/docker rm --force side-income-daily
# A backstop over the retries; a run stopped here is resumed by the timer's 11:00 start.
TimeoutStartSec=60min
